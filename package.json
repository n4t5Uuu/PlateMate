{
  "name": "platemate",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "docker compose up -d --wait && turbo run dev",
    "down": "docker compose down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "vitest run --passWithNoTests",
    "rebuild": "docker compose up -d --build --wait && turbo run build",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "pnpm --filter @platemate/backend smoke",
    "react-doctor": "pnpm --filter @platemate/frontend react-doctor",
    "services:down": "docker compose down",
    "services:restart": "docker compose restart",
    "services:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @platemate/db generate",
    "db:migrate": "pnpm --filter @platemate/db migrate",
    "db:push": "pnpm --filter @platemate/db push",
    "db:seed": "pnpm --filter @platemate/db seed",
    "db:sync": "pnpm db:push && pnpm db:seed",
    "db:studio": "pnpm --filter @platemate/db studio",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:push"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "turbo": "^2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7"
  }
}
