{
  "name": "platemate",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm services:up && turbo run dev",
    "dev:apps": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:restart": "docker compose restart",
    "services:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @platemate/db generate",
    "db:migrate": "pnpm --filter @platemate/db migrate",
    "db:push": "pnpm --filter @platemate/db push",
    "db:studio": "pnpm --filter @platemate/db studio",
    "db:reset": "docker compose down -v && pnpm services:up && pnpm db:push"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "turbo": "^2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
