# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
.next/
out/
build/
dist/
.turbo
*.tsbuildinfo
next-env.d.ts

# testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# env files: never commit secrets, but keep the example file
.env*
!.env.example

# sst / aws
.sst/
.aws-sam/
cdk.out/

# local docker data (localstack)
.localstack/
localstack-data/
volume/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editor and OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.pem

# claude code: local settings only (skills in .claude/skills are shared)
.claude/settings.local.json

# vercel
.vercel

# python (skill scripts)
__pycache__/
*.pyc
